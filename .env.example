# =============================================================================
# Chess ML Pipeline - Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust values as necessary for your local setup.

# -----------------------------------------------------------------------------
# Stockfish UCI Engine Configuration
# -----------------------------------------------------------------------------
# Path to local Stockfish binary (optional, auto-discovered if omitted)
# STOCKFISH_PATH=bin/stockfish-windows-x86-64-avx2.exe
# STOCKFISH_THREADS=1
# STOCKFISH_HASH_MB=64
# STOCKFISH_DEFAULT_DEPTH=15

# -----------------------------------------------------------------------------
# Hardware Acceleration & Compute Device
# -----------------------------------------------------------------------------
# Compute device: 'cuda', 'cpu', or 'mps'
DEVICE=cuda
# Mixed precision inference (FP16): true / false
HALF_PRECISION=true

# -----------------------------------------------------------------------------
# Dataset Ingestion & Cloud APIs (Optional)
# -----------------------------------------------------------------------------
# Roboflow Universe API Key for downloading public annotated chess datasets
# ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Kaggle API Credentials for fetching open chess vision datasets
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key

# -----------------------------------------------------------------------------
# Logging & Debugging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
